assert square_Sum(2) == 20
assert square_Sum(3) == 56
assert square_Sum(4) == 120
[BEGIN]

answer:  def square_Sum(n):
    result = 0
    for i in range(1, n + 1):
        result += (2 * i) ** 2
    return result

