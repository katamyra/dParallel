assert largest_neg([1,2,3,4,-1]) == -1
[BEGIN]

answer:  def largest_neg(nums):
    largest_neg = float('-inf')
    for num in nums:
        if num < 0:
            if num > largest_neg:
                largest_neg = num
    return largest_neg

