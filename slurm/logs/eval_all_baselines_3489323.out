You are an expert Python programmer, and here is your task: Write a python function to check whether the value exists in a sequence or not. Your code should pass these tests:

assert overlapping([1,2,3,4,5],[6,7,8,9]) == False
assert overlapping([1,2,3],[4,5,6]) == False
assert overlapping([1,4,5],[1,4,5]) == True
[BEGIN]

answer:  def overlapping(sequence1, sequence2):
    # Convert both sequences to sets to find the intersection
    set1 = set(sequence1)
    set2 = set(sequence2)
    
    # Check if there is any intersection between the two sets
    return bool(set1 & set2)

# Test cases
assert overlapping([1, 2, 3, 4, 5], [6, 7, 8, 9]) == False
assert overlapping([1, 2, 3], [4, 5, 6]) == False
assert overlapping([1, 4, 5], [1, 4, 5]) == True

print("All tests passed!")


