You are an expert Python programmer, and here is your task: Write a function to find if the given number is a keith number or not. Your code should pass these tests:

assert is_num_keith(14) == True
assert is_num_keith(12) == False
assert is_num_keith(197) == True
[BEGIN]

answer:  def is_num_keith(n):
    # Check if the number is less than 10
    if n < 10:
        return False
    
    # Check if the number is divisible by 2
    if n % 2 == 0:
        return False
    
    # Check if the number is divisible by 3
    if n % 3 == 0:
        return False
    
    # Check if the number is divisible by 5
    if n % 5 == 0:
        return False
    
    # Check if the number is divisible by 7
    if n % 7 == 0:
        return False
    
    # Check if the number is divisible by 11
    if n % 11 == 0:
        return False
    
    # Check if the number is divisible by 13
    if n % 13 == 0:
        return False
    
    # Check if the number is divisible by 17
    if n % 17 == 0:
        return False
    
    return True


