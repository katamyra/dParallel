You are an expert Python programmer, and here is your task: Write a function to find uppercase, lowercase, special character and numeric values using regex. Your code should pass these tests:

assert find_character("ThisIsGeeksforGeeks") == (['T', 'I', 'G', 'G'], ['h', 'i', 's', 's', 'e', 'e', 'k', 's', 'f', 'o', 'r', 'e', 'e', 'k', 's'], [], [])
assert find_character("Hithere2") == (['H'], ['i', 't', 'h', 'e', 'r', 'e'], ['2'], [])
assert find_character("HeyFolks32") == (['H', 'F'], ['e', 'y', 'o', 'l', 'k', 's'], ['3', '2'], [])
[BEGIN]

answer:  import re

def find_character(text):
    # Regular expression to find uppercase characters
    uppercase = re.findall(r'[A-Z]', text)
    
    # Regular expression to find lowercase characters
    lowercase = re.findall(r'[a-z]', text)
    
    # Regular expression to find special characters
    special = re.findall(r'[^a-zA-Z]', text)
    
    # Regular expression to find numeric characters
    numeric = re.findall(r'[0-9]', text)
    
    return uppercase, lowercase, special, numeric

# Test cases
assert find_character("ThisIsGeeksforGeeks") == (['T', 'I', 'G', 'G'], ['h', 'i', 's', 's', 'e', 'e', 'k', 's', 'f', 'o', 'r', 'e', 'e', 'k', 's'], [], [])
assert find_character("Hithere2") == (['H'], ['i', 't', 'h', 'e', 'r', 'e'], ['2'], [])
assert find_character("HeyFolks32") == ([], [[], [], [])
