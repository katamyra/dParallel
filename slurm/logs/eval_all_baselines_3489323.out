You are an expert Python programmer, and here is your task: Write a function that matches a word at the end of a string, with optional punctuation. Your code should pass these tests:

assert text_match_word("python.")==('Found a match!')
assert text_match_word("python.")==('Found a match!')
assert text_match_word("  lang  .")==('Not matched!')
[BEGIN]

answer:  import re

def text_match_word(text):
    pattern = r'\b\w+\b'
    match = re.search(pattern, text)
    if match:
        return match.group()
    else:
        return "Not matched!"

# Tests
assert text_match_word("python.") == "Found a match!"
assert text_match_word("python.") == "Found a match!"
assert text_match_word("  lang  .") == "Not matched!"

print("All tests passed!")


