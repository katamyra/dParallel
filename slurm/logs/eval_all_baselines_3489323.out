You are an expert Python programmer, and here is your task: Write a function to perform the adjacent element concatenation in the given tuples. Your code should pass these tests:

assert concatenate_elements(("DSP ", "IS ", "BEST ", "FOR ", "ALL ", "UTS")) == ('DSP IS ', 'IS BEST ', 'BEST FOR ', 'FOR ALL ', 'ALL UTS')
assert concatenate_elements(("RES ", "IS ", "BEST ", "FOR ", "ALL ", "QESR")) == ('RES IS ', 'IS BEST ', 'BEST FOR ', 'FOR ALL ', 'ALL QESR')
assert concatenate_elements(("MSAM", "IS ", "BEST ", "FOR ", "ALL ", "SKD")) == ('MSAMIS ', 'IS BEST ', 'BEST FOR ', 'FOR ALL ', 'ALL SKD')
[BEGIN]

answer:  def concatenate_elements(tup):
    result = []
    for i in range(len(tup) - 1):
        result.append(tup[i] + tup[i + 1])
    return result

