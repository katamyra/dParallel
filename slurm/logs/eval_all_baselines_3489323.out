assert match("Geeks") == 'Yes'
assert match("geeksforGeeks") == 'Yes'
assert match("geeks") == 'No'
[BEGIN]

answer:  import re

def match(s):
    pattern = r'[A-Z][a-z]'
    match = re.search(pattern, s)
    if match:
        return 'Yes'
    else:
        return 'No'

# Test cases
