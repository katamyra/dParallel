assert number_of_substrings("abcd") == 10
assert number_of_substrings("abcde") == 15
[BEGIN]

answer:  def number_of_substrings(s):
    count = 0
    n = len(s)
    for i in range(n):
        for j in range(i + 1, n + 1):
            count += 1
    return count

