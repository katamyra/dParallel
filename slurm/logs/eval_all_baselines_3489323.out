You are an expert Python programmer, and here is your task: Write a function to find the maximum sum we can make by dividing number in three parts recursively and summing them up together for the given number. Your code should pass these tests:

assert breakSum(12) == 13
assert breakSum(24) == 27
assert breakSum(23) == 23
[BEGIN]

answer:  def breakSum(n):
    if n == 0:
        return 0
    if n % 3 == 0:
        return n // 3
    else:
        return breakSum(n // 3) + breakSum(n % 3)

# Test cases
assert breakSum(12) == 13
assert breakSum(24) == 27
assert breakSum(23) == 23

# Additional test cases
assert breakSum(0) == 0
assert breakSum(3) == 3
assert breakSum(6) == 6
assert breakSum(9) == 9
assert breakSum(10) == 10
assert breakSum(12) == 12
assert breakSum(15) == 15
assert breakSum(18) == 18
assert breakSum(21) == 21
assert breakSum(24) == 24
assert breakSum(27) == 27
assert breakSum(30) == 30

print("All tests passed!")

