You are an expert Python programmer, and here is your task: Write a function to find the maximum profit earned from a maximum of k stock transactions Your code should pass these tests:

assert max_profit([1, 5, 2, 3, 7, 6, 4, 5], 3) == 10
assert max_profit([2, 4, 7, 5, 4, 3, 5], 2) == 7
assert max_profit([10, 6, 8, 4, 2], 2) == 2
[BEGIN]

answer:  def max_profit(prices, k):
    if not prices:
        return 0
    
    max_profit = 0
    min_price = float('inf')
    stack = []
    
    for price in prices:
        if price < min_price:
            min_price = price
        else:
            if len(stack) > 0 and price - stack[-1] < min_price:
                stack.pop()
            stack.append(price)
    
    while len(stack) > 0:
        price = stack.pop()
        max_profit = max(max_profit, price - min_price)
    
    return max_profit

# Test cases
assert max_profit([1, 5, 2, 3, 7, 6, 4, 5], 3) == 10
assert max_profit([2, 4, 7, 5, 4, 3, 5], 2) == 7
assert max_profit([10, 6, 8, 4, 2], 2) == 2

print("All tests passed.")
