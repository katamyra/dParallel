You are an expert Python programmer, and here is your task: Write a python function to check whether one root of the quadratic equation is twice of the other or not. Your code should pass these tests:

assert Check_Solution(1,3,2) == "Yes"
assert Check_Solution(1,2,3) == "No"
assert Check_Solution(1,-5,6) == "No"
[BEGIN]

answer:  import math

def Check_Solution(a, b, c):
    # Calculate the discriminant
    discriminant = b**2 - 4*a*c
    
    # Calculate the two roots
    root1 = (-b + math.sqrt(discriminant)) / (2*a)
    root2 = (-b - math.sqrt(discriminant)) / (2*a)
    
    # Check if one root is twice the other
    if root1 == 2 * root2 or root2 == 2 * root1:
        return "Yes"
    else:
        return "No"

# Test cases
assert Check_Solution(1, 3, 2) == "Yes"
assert Check_Solution(1, 2, 3) == "No"
assert Check_Solution(1, -5, 6) == "No"

print("All tests passed!")

# Note: The function calculates the roots of the quadratic equation using the quadratic formula.
# It then checks if one root is twice the other by comparing them.
# If one root is twice the other, it returns "Yes"; otherwise, it returns "No".
