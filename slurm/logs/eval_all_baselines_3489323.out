You are an expert Python programmer, and here is your task: Write a python function to find the first maximum length of even word. Your code should pass these tests:

assert find_Max_Len_Even("python language") == "language"
assert find_Max_Len_Even("maximum even length") == "length"
assert find_Max_Len_Even("eve") == "-1"
[BEGIN]

answer:  def find_Max_Len_Even(s):
    words = s.split()
    max_len = 0
    max_word = ""
    
    for word in words:
        if len(word) % 2 == 0:
            if len(word) > max_len:
                max_len = len(word)
                max_word = word
    
    return max_word if max_len > 0 else "-1"

# Test cases
assert find_Max_Len_Even("python language") == "language"
assert find_Max_Len_Even("maximum even length") == "length"
assert find_Max_Len_Even("eve") == "-1"

# Additional test cases
assert find_Max_Len_Even("a b c d") == "abcd"
assert find_Max_Len_Even("abc def ghi") == "ghi"
assert find_Max_Len_Even("abc") == "-1"
assert find_Max_Len_Even("a") == "-1"
assert find_Max_Len_Even("") == "-1"

print("All tests passed!")

