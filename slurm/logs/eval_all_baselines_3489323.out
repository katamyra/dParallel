You are an expert Python programmer, and here is your task: Write a function to find the median of a trapezium. Your code should pass these tests:

assert median_trapezium(15,25,35)==20
assert median_trapezium(10,20,30)==15
assert median_trapezium(6,9,4)==7.5
[BEGIN]

answer:  def median_trapezium(a, b, c):
    # Sort the sides of the trapezium
    sides = [a, b, c]
    sides.sort()
    
    # Find the median
    if len(sides) % 2 == 1:
        # If the number of sides is odd, return the middle element
        mid = len(sides) // 2
        return sides[mid]
    else:
        # If the number of sides is even, return the average of the two middle elements
        mid1 = len(sides) // 2 - 1
        mid2 = len(sides) // 2
        return (sides[mid1] + sides[mid2]) / 2

# Test cases
assert median_trapezium(15, 25, 35) == 20
assert median_trapezium(10, 20, 30) == 15
assert median_trapezium(6, 9, 4) == 7.5

print("All tests passed for the median_trapezium function.")

