You are an expert Python programmer, and here is your task: Write a python function to find the sum of the three lowest positive numbers from a given list of numbers. Your code should pass these tests:

assert sum_three_smallest_nums([10,20,30,40,50,60,7]) == 37
assert sum_three_smallest_nums([1,2,3,4,5]) == 6
assert sum_three_smallest_nums([0,1,2,3,4,5]) == 6
[BEGIN]

answer:  def sum_three_smallest_nums(nums):
    # Filter out non-positive numbers
    positive_nums = [num for num in nums if num > 0]
    
    # Sort the filtered positive numbers
    positive_nums.sort()
    
    # Sum the three smallest positive numbers
    return sum(positive_nums[:3])

# Tests
assert sum_three_smallest_nums([10, 20, 30, 40, 50, 60, 7]) == 37
assert sum_three_smallest_nums([1, 2, 3, 4, 5]) == 6
assert sum_three_smallest_nums([0, 1, 2, 3, 4, 5]) == 6

print("All tests passed!")


