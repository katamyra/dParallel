You are an expert Python programmer, and here is your task: Write a function to convert all possible convertible elements in the list to float. Your code should pass these tests:

assert list_to_float( [("3", "4"), ("1", "26.45"), ("7.32", "8"), ("4", "8")] ) == '[(3.0, 4.0), (1.0, 26.45), (7.32, 8.0), (4.0, 8.0)]'
assert list_to_float( [("4", "4"), ("2", "27"), ("4.12", "9"), ("7", "11")] ) == '[(4.0, 4.0), (2.0, 27.0), (4.12, 9.0), (7.0, 11.0)]'
assert list_to_float( [("6", "78"), ("5", "26.45"), ("1.33", "4"), ("82", "13")] ) == '[(6.0, 78.0), (5.0, 26.45), (1.33, 4.0), (82.0, 13.0)]'
[BEGIN]

answer:  def list_to_float(lst):
    converted_list = []
    for item in lst:
        if isinstance(item, tuple):
            converted_list.append((float(item[0]), float(item[1])))
        elif isinstance(item, str):
            converted_list.append(float(item))
    return converted_list

