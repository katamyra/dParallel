assert sumofFactors(18) == 26
assert sumofFactors(30) == 48
assert sumofFactors(6) == 8
[BEGIN]

answer:  def sumofFactors(n):
    result = 0
    for i in range(1, n + 1):
        if n % i == 0:
            result += i
    return result

