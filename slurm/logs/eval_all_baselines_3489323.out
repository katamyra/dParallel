You are an expert Python programmer, and here is your task: Write a function to find the maximum length of the subsequence with difference between adjacent elements for the given array. Your code should pass these tests:

assert max_len_sub([2, 5, 6, 3, 7, 6, 5, 8], 8) == 5
assert max_len_sub([-2, -1, 5, -1, 4, 0, 3], 7) == 4
assert max_len_sub([9, 11, 13, 15, 18], 5) == 1
[BEGIN]

answer:  def max_len_sub(arr, k):
    left = 0
    right = 0
    count = 0
    diff = 0
    max_len = 0

    while right < len(arr):
        diff = arr[right] - arr[left]
        if diff <= k:
            count += 1
            max_len = max(max_len, count)
            right += 1
        else:
            left += 1
            count = 0

    return max_len

# Test cases
assert max_len_sub([2, 5, 6, 3, 7, 6, 5, 8], 8) == 5
assert max_len_sub([-2, -1, 5, -1, 4, 0, 3], 7) == 4
assert max_len_sub([9, 11, 13, 15, 18], 5) == 1
