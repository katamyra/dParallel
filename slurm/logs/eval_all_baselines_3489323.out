You are an expert Python programmer, and here is your task: Write a function to reflect the modified run-length encoding from a list. Your code should pass these tests:

assert modified_encode([1,1,2,3,4,4,5,1])==[[2, 1], 2, 3, [2, 4], 5, 1]
assert modified_encode('automatically')==['a', 'u', 't', 'o', 'm', 'a', 't', 'i', 'c', 'a', [2, 'l'], 'y']
assert modified_encode('python')==['p', 'y', 't', 'h', 'o', 'n']
[BEGIN]

answer:  def modified_encode(lst):
    encoded = []
    count = 1
    for item in lst:
        if item == lst[-1]:
            count += 1
        else:
            encoded.append([count, item])
            count = 1
    encoded.append([count, lst[-1]])
    return encoded

# Test cases
assert modified_encode([1, 1, 2, 3, 4, 4, 5, 1]) == [[2, 1], 2, 3, [2, 4], 5, 1]
assert modified_encode('automatically') == ['a', 'u', 't', 'o', 'm', 'a', 't', 'i', 'c', 'a', [2, 'l'], 'y']
assert modified_encode('python') == ['p', 'y', 't', 'h', 'o', 'n']
