You are an expert Python programmer, and here is your task: Write a function to find if the given number is a keith number or not. Your code should pass these tests:

assert is_num_keith(14) == True
assert is_num_keith(12) == False
assert is_num_keith(197) == True
[BEGIN]

answer:  def is_num_keith(num):
    if num < 10:
        return False
    if num % 2 == 0:
        return False
    if num % 5 == 0:
        return False
    if num % 7 == 0:
        return False
    if num % 11 == 0:
        return False
    if num % 13 == 0:
        return False
    if num % 17 == 0:
        return False
    if num % 19 == 0:
        return False
    if num % 23 == 0:
        return False
    if num % 29 == 0:
        return False
    if num % 31 == 0:
        return False
    if num % 37 == 0:
        return False
    if num % 41 == 0:
        return False
    if num % 43 == 0:
        return False
    if num % 47 == 0:
        return False
    return True

