assert minimum_Length("mnm") == 1
assert minimum_Length("abcda") == 3
assert minimum_Length("abcb") == 2
[BEGIN]

answer:  def minimum_Length(s):
    count = 0
    for i in range(len(s)):
        if s[i] == s[i-1]:
            count += 1
    return count

