assert check_Consecutive([1,2,1]) == False
[BEGIN]

answer:  def check_Consecutive(nums):
    if len(nums) < 2:
        return False
    for i in range(len(nums) - 1):
        if nums[i] != nums[i + 1] - 1:
            return False
    return True
