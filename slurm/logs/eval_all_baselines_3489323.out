You are an expert Python programmer, and here is your task: Write a function to sort the given list based on the occurrence of first element of tuples. Your code should pass these tests:

assert sort_on_occurence([(1, 'Jake'), (2, 'Bob'), (1, 'Cara')]) == [(1, 'Jake', 'Cara', 2), (2, 'Bob', 1)]
assert sort_on_occurence([('b', 'ball'), ('a', 'arm'), ('b', 'b'), ('a', 'ant')]) == [('b', 'ball', 'b', 2), ('a', 'arm', 'ant', 2)]
assert sort_on_occurence([(2, 'Mark'), (3, 'Maze'), (2, 'Sara')]) == [(2, 'Mark', 'Sara', 2), (3, 'Maze', 1)]
[BEGIN]

answer:  def sort_on_occurence(tuples_list):
    from collections import Counter
    
    # Count the occurrences of each element in the first position
    element_count = Counter(tuples_list)
    
    # Create a list of tuples with the first element and its count
    sorted_list = [(element, count) for element, count in element_count.items()]
    
    # Sort the list based on the count in descending order
    sorted_list.sort(key=lambda x: x[1], reverse=True)
    
    return sorted_list

