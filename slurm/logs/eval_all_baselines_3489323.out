[BEGIN]

answer:  def assign_freq(tuple_list):
    freq_dict = {}
    for tup in tuple_list:
        if tup in freq_dict:
            freq_dict[tup] += 1
        else:
            freq_dict[tup] = 1
    return list(freq_dict.items())

