You are an expert Python programmer, and here is your task: Write a function to extract the ranges that are missing from the given list with the given start range and end range values. Your code should pass these tests:

assert extract_missing([(6, 9), (15, 34), (48, 70)], 2, 100) == [(2, 6), (9, 100), (9, 15), (34, 100), (34, 48), (70, 100)]
assert extract_missing([(7, 2), (15, 19), (38, 50)], 5, 60) == [(5, 7), (2, 60), (2, 15), (19, 60), (19, 38), (50, 60)]
assert extract_missing([(7, 2), (15, 19), (38, 50)], 1, 52) == [(1, 7), (2, 52), (2, 15), (19, 52), (19, 38), (50, 52)]
[BEGIN]

answer:  def extract_missing(ranges, start_range, end_range):
    missing_ranges = []
    for range in ranges:
        if start_range <= range[0] <= end_range:
            missing_ranges.append(range)
        if start_range <= range[1] <= end_range:
            missing_ranges.append(range)
    return missing_ranges

