You are an expert Python programmer, and here is your task: Write a function to find the largest sum of contiguous array in the modified array which is formed by repeating the given array k times. Your code should pass these tests:

assert max_sub_array_sum_repeated([10, 20, -30, -1], 4, 3) == 30
assert max_sub_array_sum_repeated([-1, 10, 20], 3, 2) == 59
assert max_sub_array_sum_repeated([-1, -2, -3], 3, 3) == -1
[BEGIN]

answer:  def max_sub_array_sum_repeated(arr, n, k):
    # Repeat the array k times
    repeated_arr = [arr] * k
    
    # Initialize the maximum sum with the sum of the first array
    max_sum = sum(repeated_arr)
    
    # Iterate through the repeated array to find the maximum sum of any contiguous subarray
    for i in range(1, k):
        current_sum = sum(repeated_arr[i])
        if current_sum > max_sum:
            max_sum = current_sum
    
    return max_sum

# Test cases
assert max_sub_array_sum_repeated([10, 20, -30, -1], 4, 3) == 30
assert max_sub_array_sum_repeated([-1, 10, 20], 3, 2) == 59
assert max_sub_array_sum_repeated([-1, -2, -3], 3, 3) == -1
