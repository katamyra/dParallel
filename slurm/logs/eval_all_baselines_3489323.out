You are an expert Python programmer, and here is your task: Write a function to check if the letters of a given string can be rearranged so that two characters that are adjacent to each other are different. Your code should pass these tests:

assert rearange_string("aab")==('aba')
assert rearange_string("aabb")==('abab')
assert rearange_string("abccdd")==('cdabcd')
[BEGIN]

answer:  def rearange_string(s):
    n = len(s)
    if n < 2:
        return s
    
    # Count the frequency of each character
    freq = {}
    for char in s:
        if char in freq:
            freq[char] += 1
        else:
            freq[char] = 1
    
    # Sort the characters by their frequency
    sorted_chars = sorted(freq.items(), key=lambda x: x[1], reverse=True)
    
    # Build the result string
    result = []
    prev_char = None
    for char, count in sorted_chars:
        if prev_char is None or prev_char != char:
            result.append(char)
            prev_char = char
        else:
            result.append(prev_char)
    
    return ''.join(result)

# Test cases
assert rearange_string("aab") == "aba"
assert rearange_string("aabb") == "abab"
assert rearange_string("abccdd") == "cdabcd"
assert rearange_string("aabbccdd") == "aabbccdd"

