You are an expert Python programmer, and here is your task: Write a function to print the season for the given month and day. Your code should pass these tests:

assert month_season('January',4)==('winter')
assert month_season('October',28)==('autumn')
assert month_season('June',6)==('spring')
[BEGIN]

answer:  def month_season(month, day):
    # Convert the month to a number
    month_num = int(month.lower())
    
    # Determine the season based on the month
    if month_num == 1 or month_num == 2 or month_num == 3:
        return 'winter'
    elif month_num == 4 or month_num == 5 or month_num == 6:
        return 'spring'
    elif month_num == 7 or month_num == 8 or month_num == 9:
        return 'summer'
    elif month_num == 10 or month_num == 11 or month_num == 12:
        return 'autumn'
    else:
        return 'unknown'

# Test cases
assert month_season('January', 4) == 'winter'
assert month_season('October', 28) == 'autumn'
assert month_season('June', 6) == 'spring'
assert month_season('July', 15) == 'summer'
assert month_season('December', 10) == 'autumn'


