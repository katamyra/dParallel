assert find_max([(2, 4), (6, 7), (5, 1), (6, 10), (8, 7)]) == 10
assert find_max([(3, 5), (7, 8), (6, 2), (7, 11), (9, 8)]) == 11
assert find_max([(4, 6), (8, 9), (7, 3), (8, 12), (10, 9)]) == 12
[BEGIN]

answer:  def find_max(tuples):
    max_element = float('-inf')
    for t in tuples:
        if t[1] > max_element:
            max_element = t[1]
    return max_element

# Tests
