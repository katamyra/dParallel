You are an expert Python programmer, and here is your task: Write a python function to find k number of operations required to make all elements equal. Your code should pass these tests:

assert min_Ops([2,2,2,2],4,3) == 0
assert min_Ops([4,2,6,8],4,3) == -1
assert min_Ops([21,33,9,45,63],5,6) == 24
[BEGIN]

answer:  def min_Ops(arr, n, k):
    minimum = min(arr)
    maximum = max(arr)
    operations = 0
    for i in range(n):
        if arr[i] < minimum:
            operations += arr[i] - minimum
        elif arr[i] > maximum:
            operations += maximum - arr[i]
    if operations > k:
        return -1
    return operations

# Test cases
assert min_Ops([2, 2, 2, 2], 4, 3) == 0
assert min_Ops([4, 2, 6, 8], 4, 3) == -1
assert min_Ops([21, 33, 9, 45, 63], 5, 6) == 24
