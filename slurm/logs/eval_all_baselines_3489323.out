You are an expert Python programmer, and here is your task: Write a function to count the longest repeating subsequences such that the two subsequences don’t have same string characters at same positions. Your code should pass these tests:

assert find_longest_repeating_subseq("AABEBCDD") == 3
assert find_longest_repeating_subseq("aabb") == 2
assert find_longest_repeating_subseq("aab") == 1
[BEGIN]

answer:  def find_longest_repeating_subseq(s):
    n = len(s)
    count = 0
    seen = {}
    stack = []

    for i in range(n):
        if s[i] not in seen:
            seen[s[i]] = i
            stack.append(i)
        else:
            while stack and s[stack[-1]] == s[i]:
                stack.pop()
            if stack:
                start = stack.pop()
                end = i
                if end - start + 1 > 1:
                    count += 1

    return count

# Test cases
assert find_longest_repeating_subseq("AABEBCDD") == 3
assert find_longest_repeating_subseq("aabb") == 2
assert find_longest_repeating_subseq("aab") == 1

print("All tests passed!")
