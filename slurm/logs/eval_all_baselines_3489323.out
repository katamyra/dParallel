assert neg_count([-1,-2,3,-4,-5]) == 4
assert neg_count([1,2,3]) == 0
assert neg_count([1,2,-3,-10,20]) == 2
[BEGIN]

answer:  def neg_count(numbers):
    count = 0
    for num in numbers:
        if num < 0:
            count += 1
    return count

