assert cube_Sum(2) == 72
assert cube_Sum(3) == 288
assert cube_Sum(4) == 800
[BEGIN]

answer:  def cube_Sum(n):
    result = 0
    for i in range(1, n + 1):
        if i % 2 == 0:
            result += i ** 3
    return result

