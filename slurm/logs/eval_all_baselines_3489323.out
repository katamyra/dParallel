assert is_coprime(15,21) == False
assert is_coprime(25,45) == False
[BEGIN]

answer:  def is_coprime(a, b):
    return gcd(a, b) == 1

def gcd(a, b):
    while b != 0:
        a, b = b, a % b
    return a

# Test cases
