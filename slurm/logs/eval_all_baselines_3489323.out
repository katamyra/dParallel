You are an expert Python programmer, and here is your task: Write a function to find the ration of positive numbers in an array of integers. Your code should pass these tests:

assert positive_count([0, 1, 2, -1, -5, 6, 0, -3, -2, 3, 4, 6, 8])==0.54
assert positive_count([2, 1, 2, -1, -5, 6, 4, -3, -2, 3, 4, 6, 8])==0.69
assert positive_count([2, 4, -6, -9, 11, -12, 14, -5, 17])==0.56
[BEGIN]

answer:  def positive_count(arr):
    positive_count = sum(1 for x in arr if x > 0)
    total_count = len(arr)
    if total_count == 0:
        return 0.0
    return positive_count / total_count

# Test cases
assert positive_count([0, 1, 2, -1, -5, 6, 0, -3, -2, 3, 4, 6, 8]) == 0.54
assert positive_count([2, 1, 2, -1, -5, 6, 4, -3, -2, 3, 4, 6, 8]) == 0.69
assert positive_count([2, 4, -6, -9, 11, -12, 14, -5, 17]) == 0.56

