You are an expert Python programmer, and here is your task: Write a function to find the maximum product subarray of the given array. Your code should pass these tests:

assert max_subarray_product([1, -2, -3, 0, 7, -8, -2]) == 112
assert max_subarray_product([6, -3, -10, 0, 2]) == 180 
assert max_subarray_product([-2, -40, 0, -2, -3]) == 80
[BEGIN]

answer:  def max_subarray_product(nums):
    if not nums:
        return 0

    max_product = min_product = nums[0]

    for num in nums[1:]:
        if num > 0:
            max_product = max(max_product, min_product * num)
            min_product = min(min_product, num)
        else:
            max_product = max(max_product, min_product * -num)
            min_product = min(min_product, -num)

    return max_product

# Tests
assert max_subarray_product([1, -2, -3, 0, 7, -8, -2]) == 112
assert max_subarray_product([6, -3, -10, 0, 2]) == 180
assert max_subarray_product([-2, -40, 0, -2, -3]) == 80

print("All tests passed!")
