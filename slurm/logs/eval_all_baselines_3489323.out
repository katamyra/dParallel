answer:  def max_aggregate(tuples):
    max_aggregate = 0
    max_aggregate_name = None
    
    for name, score in tuples:
        if score > max_aggregate:
            max_aggregate = score
            max_aggregate_name = name
    
    return (max_aggregate_name, max_aggregate)

