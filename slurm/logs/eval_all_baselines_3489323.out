You are an expert Python programmer, and here is your task: Write a python function to find the difference between sum of even and odd digits. Your code should pass these tests:

assert is_Diff (12345) == False
assert is_Diff(1212112) == True
assert is_Diff(1212) == False
[BEGIN]

answer:  def is_Diff(n):
    even_sum = 0
    odd_sum = 0
    
    # Convert the number to a string to iterate over each digit
    num_str = str(n)
    
    # Iterate over each digit in the string
    for digit in num_str:
        # Convert the character back to an integer
        digit = int(digit)
        
        # Check if the digit is even or odd
        if digit % 2 == 0:
            even_sum += digit
        else:
            odd_sum += digit
    
    # Calculate the difference between the sum of even and odd digits
    diff = even_sum - odd_sum
    
    # Check if the difference is zero
    return diff == 0

# Test cases
assert is_Diff(12345) == False
assert is_Diff(1212112) == True
assert is_Diff(1212) == False
