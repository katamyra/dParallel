You are an expert Python programmer, and here is your task: Write a function to solve gold mine problem. Your code should pass these tests:

assert get_maxgold([[1, 3, 1, 5],[2, 2, 4, 1],[5, 0, 2, 3],[0, 6, 1, 2]],4,4)==16
assert get_maxgold([[10,20],[30,40]],2,2)==70
assert get_maxgold([[4,9],[3,7]],2,2)==13
[BEGIN]

answer:  def get_maxgold(mine, rows, cols):
    # Initialize a 2D array to store the maximum gold up to each cell
    max_gold = [[0] * cols for _ in range(rows)]
    
    # Fill the first row of the max_gold array
    for j in range(cols):
        max_gold[0][j] = mine[0][j]
    
    # Fill the first column of the max_gold array
    for i in range(1, rows):
        max_gold[i][0] = mine[i][0]
    
    # Fill the rest of the max_gold array
    for i in range(1, rows):
        for j in range(1, cols):
            max_gold[i][j] = mine[i][j] + max(max_gold[i-1][j], max_gold[i][j-1])
    
    # The maximum gold can be found in the bottom-right cell of the max_gold array
    return max_gold[rows-1][cols-1]

