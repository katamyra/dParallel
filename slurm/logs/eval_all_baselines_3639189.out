You are an expert Python programmer, and here is your task: Write a python function to count the occurence of all elements of list in a tuple. Your code should pass these tests:

assert count_Occurrence(('a', 'a', 'c', 'b', 'd'),['a', 'b'] ) == 3
assert count_Occurrence((1, 2, 3, 1, 4, 6, 7, 1, 4),[1, 4, 7]) == 6
assert count_Occurrence((1,2,3,4,5,6),[1,2]) == 2
[BEGIN]

answer:  def count_Occurrence(tup, lst):
    counts = {}
    for item in lst:
        if item in counts:
            counts[item] += 1
        else:
            counts[item] = 1
    
    for item in tup:
        if item in counts:
            counts[item] -= 1
            if counts[item] == 0:
                del counts[item]
        else:
            counts[item] = 1
    
    return sum(counts.values())

# Test cases
assert count_Occurrence(('a', 'a', 'c', 'b', 'd'), ['a', 'b']) == 3
assert count_Occurrence((1, 2, 3, 1, 4, 6, 7, 1, 4), [1, 4, 7]) == 6
assert count_Occurrence((1, 2, 3, 4, 5, 6), [1, 2]) == 2

