You are an expert Python programmer, and here is your task: Write a function to find the item with maximum frequency in a given list. Your code should pass these tests:

assert max_occurrences([2,3,8,4,7,9,8,2,6,5,1,6,1,2,3,2,4,6,9,1,2])==(2, 5)
assert max_occurrences([2,3,8,4,7,9,8,7,9,15,14,10,12,13,16,16,18])==(8, 2)
assert max_occurrences([10,20,20,30,40,90,80,50,30,20,50,10])==(20, 3)
[BEGIN]

answer:  def max_occurrences(lst):
    from collections import Counter
    counter = Counter(lst)
    max_count = max(counter.values())
    max_frequent_items = [item for item, count in counter.items() if count == max_count]
    return max_frequent_items

# Tests
assert max_occurrences([2,3,8,4,7,9,8,2,6,5,1,6,1,2,3,2,4,6,9,1,2]) == (2, 5)
assert max_occurrences([2,3,8,4,7,9,8,7,9,15,14,10,12,13,16,16,18]) == (8, 2)
assert max_occurrences([10,20,20,30,40,90,80,50,30,20,50,10]) == (20, 3)
