def add_elements(arr, k):
    """
    Given a non-empty array of integers arr and an integer k, return
    the sum of the elements with at most two digits from the first k elements of arr.

    Example:

        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4
        Output: 24 # sum of 21 + 3

    Constraints:
        1. 1 <= len(arr) <= 100
        2. 1 <= k <= len(arr)
    """

```
 
answer:  ```python

def add_elements(arr, k):
    """
    Given a non-empty array of integers arr and an integer k, return
    the sum of the elements with at most two digits from the first k elements of arr.

    Example:

        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4
        Output: 24 # sum of 21 + 3

    Constraints:
        1. 1 <= len(arr) <= 100
        2. 1 <= k <= len(arr)
    """
    # Get the first k elements of the array
    first_k_elements = arr[:k]
    
    # Iterate through the first k elements and sum the elements with at most two digits
    total = 0
    for num in first_k_elements:
        # Check if the number has at most two digits
        if len(str(num)) <= 2:
            # Add the number to the total sum
            total += num
    
    # Return the total sum
    return total

```
