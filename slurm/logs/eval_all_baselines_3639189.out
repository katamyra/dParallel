answer:  def calculate_polygons(x1, y1, x2, y2, x3, y3):
    result = []
    for i in range(6):
        polygon = []
        for j in range(6):
            x = x1 + (x2 - x1) * math.cos(math.radians(60 * (i + j)))
            y = y1 + (y2 - y1) * math.sin(math.radians(60 * (i + j)))
            polygon.append((x, y))
        result.append(polygon)
    return result

def calculate_polygons(x1, y1, x2, y2, x3, y3):
    result = []
    for i in range(6):
        polygon = []
        for j in range(6):
            x = x1 + (x2 - x1) * math.cos(math.radians(60 * (i + j)))
            y = y1 + (y2 - y1) * math.sin(math.radians(60 * (i + j)))
            polygon.append((x, y))
        result.append(polygon)
