You are an expert Python programmer, and here is your task: Write a function to trim each tuple by k in the given tuple list. Your code should pass these tests:

assert trim_tuple([(5, 3, 2, 1, 4), (3, 4, 9, 2, 1),(9, 1, 2, 3, 5), (4, 8, 2, 1, 7)], 2) == '[(2,), (9,), (2,), (2,)]'
assert trim_tuple([(5, 3, 2, 1, 4), (3, 4, 9, 2, 1), (9, 1, 2, 3, 5), (4, 8, 2, 1, 7)], 1) == '[(3, 2, 1), (4, 9, 2), (1, 2, 3), (8, 2, 1)]'
assert trim_tuple([(7, 8, 4, 9), (11, 8, 12, 4),(4, 1, 7, 8), (3, 6, 9, 7)], 1) == '[(8, 4), (8, 12), (1, 7), (6, 9)]'
[BEGIN]

answer:  def trim_tuple(tuple_list, k):
    trimmed_tuples = []
    for tup in tuple_list:
        trimmed_tup = tuple(tup[:-k])
        trimmed_tuples.append(trimmed_tup)
    return trimmed_tuples

# Test cases
assert trim_tuple([(5, 3, 2, 1, 4), (3, 4, 9, 2, 1), (9, 1, 2, 3, 5), (4, 8, 2, 1, 7)], 1) == [(3, 2, 1), (4, 9, 2), (1, 2, 3), (8, 2, 1)]
assert trim_tuple([(7, 8, 4, 9), (11, 8, 12, 4), (4, 1, 7, 8), (3, 6, 9, 7)], 1) == [(8, 4), (8, 12), (1, 7), (6,)]

