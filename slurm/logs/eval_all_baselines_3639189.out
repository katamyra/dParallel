You are an expert Python programmer, and here is your task: Write a function to replace the last element of the list with another list. Your code should pass these tests:

assert replace_list([1, 3, 5, 7, 9, 10],[2, 4, 6, 8])==[1, 3, 5, 7, 9, 2, 4, 6, 8]
assert replace_list([1,2,3,4,5],[5,6,7,8])==[1,2,3,4,5,6,7,8]
assert replace_list(["red","blue","green"],["yellow"])==["red","blue","yellow"]
[BEGIN]

answer:  def replace_list(original_list, new_list):
    # Remove the last element of the original list
    original_list.pop()
    # Append the new list to the end of the original list
    original_list.extend(new_list)
    return original_list

# Test cases
assert replace_list([1, 3, 5, 7, 9, 10], [2, 4, 6, 8]) == [1, 3, 5, 7, 9, 2, 4, 6, 8]
assert replace_list([1, 2, 3, 4, 5], [5, 6, 7, 8]) == [1, 2, 3, 4, 5, 6, 7, 8]
assert replace_list(["red", "blue", "green"], ["yellow"]) == ["red", "blue", "yellow"]

print("All tests passed!")
