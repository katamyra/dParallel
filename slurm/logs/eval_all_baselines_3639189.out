assert ncr_modp(10,2,13)==6
assert ncr_modp(15,12,43)==25
assert ncr_modp(17,9,18)==10
[BEGIN]

answer:  def ncr_modp(n, r, p):
    result = 1
    for i in range(1, r + 1):
        result = (result * i) % p
    return result

