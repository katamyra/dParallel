You are an expert Python programmer, and here is your task: Write a python function to convert octal number to decimal number. Your code should pass these tests:

assert octal_To_Decimal(25) == 21
assert octal_To_Decimal(30) == 24
assert octal_To_Decimal(40) == 32
[BEGIN]

answer:  def octal_To_Decimal(octal_num):
    # Convert the octal number to a string
    octal_str = str(octal_num)
    
    # Initialize the decimal number
    decimal_num = 0
    
    # Iterate over each character in the octal string
    for char in octal_str:
        # Convert the character to an integer
        digit = int(char)
        
        # Calculate the power of 8 for the current digit
        power = 8 ** (len(octal_str) - 1 - char.index(octal_str[0]))
        
        # Add the product of the digit and the power of 8 to the decimal number
        decimal_num += digit * power
    
    return decimal_num

# Test cases
assert octal_To_Decimal(25) == 21
assert octal_To_Decimal(30) == 24
assert octal_To_Decimal(40) == 32

print("All tests passed!")
