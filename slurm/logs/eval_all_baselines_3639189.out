You are an expert Python programmer, and here is your task: Write a function to check if the given number is woodball or not. Your code should pass these tests:

assert is_woodall(383) == True
assert is_woodall(254) == False
assert is_woodall(200) == False
[BEGIN]

answer:  def is_woodall(num):
    # Check if the number is greater than 200
    if num <= 200:
        return False
    
    # Check if the number is divisible by 3
    if num % 3 == 0:
        return False
    
    # Check if the number is divisible by 7
    if num % 7 == 0:
        return False
    
    # Check if the number is divisible by 11
    if num % 11 == 0:
        return False
    
    # Check if the number is divisible by 13
    if num % 13 == 0:
        return False
    
    # Check if the number is divisible by 17
    if num % 17 == 0:
        return False
    
    # If all conditions are met, the number is a woodball
    return True

