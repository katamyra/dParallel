assert highest_Power_of_2(10) == 8
assert highest_Power_of_2(19) == 16
assert highest_Power_of_2(32) == 32
[BEGIN]

answer:  def highest_Power_of_2(n):
    if n == 0:
        return 0
    elif n == 1:
        return 1
    elif n == 2:
        return 2
    elif n == 3:
        return 4
    elif n == 4:
        return 8
    elif n == 5:
        return 16
    elif n == 6:
        return 32
    elif n == 7:
        return 64
    elif n == 8:
        return 128
    elif n == 9:
        return 256
    elif n == 10:
        return 512
    elif n == 11:
        return 1024
    elif n == 12:
        return 2048
    elif n == 13:
        return 4096
    elif n == 14:
        return 8192
    else:
        raise ValueError("The given number is not a power of 2")

