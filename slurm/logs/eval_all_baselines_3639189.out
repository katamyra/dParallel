You are an expert Python programmer, and here is your task: Write a python function to count characters at same position in a given string (lower and uppercase characters) as in english alphabet. Your code should pass these tests:

assert count_char_position("xbcefg") == 2
assert count_char_position("ABcED") == 3
assert count_char_position("AbgdeF") == 5
[BEGIN]

answer:  def count_char_position(s):
    count = 0
    for char in s:
        if char.islower():
            position = ord(char) - ord('a')
        else:
            position = ord(char) - ord('A') + 26
        if position == 0:
            count += 1
        elif position == 1:
            count += 1
        elif position == 2:
            count += 1
        elif position == 3:
            count += 1
        elif position == 4:
            count += 1
        elif position == 5:
            count += 1
        elif position == 6:
            count += 1
        elif position == 7:
            count += 1
        elif position == 8:
            count += 1
        elif position == 9:
            count += 1
        elif position == 10:
            count += 1
        elif position == 11:
            count += 1
        elif position == 12:
            count += 1
    return count

