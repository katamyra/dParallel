assert zigzag(4, 3) == 5
assert zigzag(4, 2) == 4
assert zigzag(3, 1) == 1
[BEGIN]

answer:  def zigzag(n, k):
    result = 0
    for i in range(1, n + 1):
        if i % k == 0:
            result += 1
    return result

