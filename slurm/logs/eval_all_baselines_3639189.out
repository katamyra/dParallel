assert calculate_polygons(9,6,4,3,2)==[[(5.0, 2.5358983848622456), (5.0, 4.8452994616207485), (7.0, 6.0), (9.0, 4.8452994616207485), (9.0, 2.5358983848622456), (7.0, 1.3811978464829942), (5.0, 2.5358983848622456)], [(7.0, 6.0), (7.0, 8.309401076758503), (9.0, 9.464101615137753), (11.0, 8.309401076758503), (11.0, 6.0), (9.0, 4.8452994616207485), (7.0, 6.0)]]
[BEGIN]

answer:  def calculate_polygons(x1, y1, x2, y2, n):
    polygons = []
    for i in range(n):
        polygon = []
        for j in range(6):
            x = x1 + (x2 - x1) * math.cos(math.radians(60 * (i + j)))
            y = y1 + (y2 - y1) * math.sin(math.radians(60 * (i + j)))
            polygon.append((x, y))
        polygons.append(polygon)
    return polygons

import math
print(calculate_polygons(1, 1, 4, 4, 3))
print(calculate_polygons(5, 4, 7, 9, 8))
print(calculate_polygons(9, 6, 4, 3, 2))
print(calculate_polygons(0, 0, 1, 1, 1))
print(calculate_polygons(0, 0, 1, 1, 5))
print(calculate_polygons(0, 0, 1, 1, 10))
