You are an expert Python programmer, and here is your task: Write a function to find the smallest range that includes at-least one element from each of the given arrays. Your code should pass these tests:

assert find_minimum_range([[3, 6, 8, 10, 15], [1, 5, 12], [4, 8, 15, 16], [2, 6]]) == (4, 6)
assert find_minimum_range([[ 2, 3, 4, 8, 10, 15 ], [1, 5, 12], [7, 8, 15, 16], [3, 6]]) == (4, 7)
assert find_minimum_range([[4, 7, 9, 11, 16], [2, 6, 13], [5, 9, 16, 17], [3, 7]]) == (5, 7)
[BEGIN]

answer:  def find_minimum_range(arrays):
    # Flatten the list of arrays into a single list
    flat_list = [item for sublist in arrays for item in sublist]
    
    # Find the minimum and maximum values in the flattened list
    min_val = min(flat_list)
    max_val = max(flat_list)
    
    return (min_val, max_val)

# Tests
assert find_minimum_range([[3, 6, 8, 10, 15], [1, 5, 12], [4, 8, 15, 16], [2, 6]]) == (4, 6)
assert find_minimum_range([[2, 3, 4, 8, 10, 15], [1, 5, 12], [7, 8, 15, 16], [3, 6]]) == (4, 7)
assert find_minimum_range([[4, 7], [2, 6], [5, 9, 16], [3, 7]]) == (5, 7)
