You are an expert Python programmer, and here is your task: Write a python function to find the maximum occuring divisor in an interval. Your code should pass these tests:

assert find_Divisor(2,2) == 2
assert find_Divisor(2,5) == 2
assert find_Divisor(5,10) == 2
[BEGIN]

answer:  def find_Divisor(start, end):
    max_divisor = 0
    for num in range(start, end + 1):
        if num % max_divisor == 0:
            max_divisor = num
    return max_divisor

# Test cases
assert find_Divisor(2, 2) == 2
assert find_Divisor(2, 5) == 2
assert find_Divisor(5, 10) == 2

# Additional test cases
assert find_Divisor(1, 10) == 1
assert find_Divisor(10, 20) == 10
assert find_Divisor(20, 30) == 10
assert find_Divisor(30, 40) == 10
assert find_Divisor(40, 50) == 10
assert find_Divisor(50, 60) == 10
assert find_Divisor(60, 70) == 10
assert find_Divisor(70, 80) == 10
