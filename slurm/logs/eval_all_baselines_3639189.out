You are an expert Python programmer, and here is your task: Write a function to find the minimum value in a given heterogeneous list. Your code should pass these tests:

assert min_val(['Python', 3, 2, 4, 5, 'version'])==2
assert min_val(['Python', 15, 20, 25])==15
assert min_val(['Python', 30, 20, 40, 50, 'version'])==20
[BEGIN]

answer:  def min_val(heterogeneous_list):
    if not heterogeneous_list:
        raise ValueError("The list is empty")
    
    # Convert the list to a set to remove duplicates
    unique_values = set(heterogeneous_list)
    
    # Find the minimum value in the set
    min_value = min(unique_values)
    
    return min_value

# Test cases
assert min_val(['Python', 3, 2, 4, 5, 'version']) == 2
assert min_val(['Python', 15, 20, 25]) == 15
assert min_val(['Python', 30, 20, 40, 50, 'version']) == 20

print("All tests passed!")


