You are an expert Python programmer, and here is your task: Write a python function to find the first element occurring k times in a given array. Your code should pass these tests:

assert first_Element([0,1,2,3,4,5],6,1) == 0
assert first_Element([1,2,1,3,4],5,2) == 1
assert first_Element([2,3,4,3,5,7,1,2,3,5],10,2) == 2
[BEGIN]

answer:  def first_Element(arr, n, k):
    # Create a dictionary to count the occurrences of each element
    count = {}
    for num in arr:
        if num in count:
            count[num] += 1
        else:
            count[num] = 1
    
    # Find the first element that occurs k times
    for num in count:
        if count[num] == k:
            return num
    
    return None  # or raise ValueError if no element occurs k times

# Test cases
assert first_Element([0, 1, 2, 3, 4, 5], 6, 1) == 0
assert first_Element([1, 2, 1, 3, 4], 5, 2) == 1
assert first_Element([2, 3, 4, 3, 5, 7, 1, 2, 3, 5], 10, 2) == 2
