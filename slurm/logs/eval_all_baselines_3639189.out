assert upper_ctr('PYthon') == 1
assert upper_ctr('BigData') == 1
assert upper_ctr('program') == 0
[BEGIN]

answer:  def upper_ctr(s):
    count = 0
    for char in s:
        if char.isupper():
            count += 1
    return count

