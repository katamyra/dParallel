assert odd_Equivalent("11011",5) == 4
assert odd_Equivalent("1010",4) == 2
[BEGIN]

answer:  def odd_Equivalent(s, n):
    count = 0
    for i in range(n):
        if s[i] == '1':
            count += 1
    return count

