You are an expert Python programmer, and here is your task: Write a function to find the longest common subsequence for the given two sequences. Your code should pass these tests:

assert longest_common_subsequence("AGGTAB" , "GXTXAYB", 6, 7) == 4
assert longest_common_subsequence("ABCDGH" , "AEDFHR", 6, 6) == 3
assert longest_common_subsequence("AXYT" , "AYZX", 4, 4) == 2
[BEGIN]

answer:  def longest_common_subsequence(seq1, seq2, len1, len2):
    dp = [[0] * (len1 + 1) for _ in range(len2 + 1)]
    for i in range(1, len2 + 1):
        for j in range(1, len1 + 1):
            if seq1[i - 1] == seq2[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])
    return dp[len2][len1]

