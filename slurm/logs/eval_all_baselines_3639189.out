You are an expert Python programmer, and here is your task: Write a function to check if a url is valid or not using regex. Your code should pass these tests:

assert is_valid_URL("https://www.google.com") == True
assert is_valid_URL("https:/www.gmail.com") == False
assert is_valid_URL("https:// www.redit.com") == False
[BEGIN]

answer:  import re

def is_valid_URL(url):
    # Define the regex pattern for a valid URL
    pattern = r'^(https?://[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$'
    
    # Use re.match to check if the URL matches the pattern
    return re.match(pattern, url) is not None

# Test cases
assert is_valid_URL("https://www.google.com") == True
assert is_valid_URL("https:/www.gmail.com") == False
assert is_valid_URL("https:// www.redit.com") == False

print("All tests passed!")


