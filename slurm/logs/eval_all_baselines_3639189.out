You are an expert Python programmer, and here is your task: Write a function to remove a specified column from a given nested list. Your code should pass these tests:

assert remove_column([[1, 2, 3], [2, 4, 5], [1, 1, 1]],0)==[[2, 3], [4, 5], [1, 1]]
assert remove_column([[1, 2, 3], [-2, 4, -5], [1, -1, 1]],2)==[[1, 2], [-2, 4], [1, -1]]
assert remove_column([[1, 3], [5, 7], [1, 3], [13, 15, 17], [5, 7], [9, 11]],0)==[[3], [7], [3], [15, 17], [7], [11]]
[BEGIN]

answer:  def remove_column(nested_list, column_index):
    # Check if the column index is within the range of the nested list
    if column_index < 0 or column_index >= len(nested_list[0]):
        raise ValueError("Column index out of range")
    
    # Create a new list with the specified column removed
    new_list = []
    for row in nested_list:
        # Remove the specified column from each row
        new_row = [element for element in row if element != column_index]
        new_list.append(new_row)
    
    return new_list

# Test cases
assert remove_column([[1, 2, 3], [2, 4, 5], [1, 1, 1]], 0) == [[2, 3], [4, 5], [1, 1]]
assert remove_column([[1, 2, 3], [-2, 4, -5], [1, -1, 1]], 2) == [[1, 2], [-2, 4], [1, -1]]
# Add more test cases as needed to cover different scenarios


