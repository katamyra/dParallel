You are an expert Python programmer, and here is your task: Write a function to delete the smallest element from the given heap and then insert a new item. Your code should pass these tests:

assert heap_replace( [25, 44, 68, 21, 39, 23, 89],21)==[21, 25, 23, 44, 39, 68, 89]
assert heap_replace([25, 44, 68, 21, 39, 23, 89],110)== [23, 25, 68, 44, 39, 110, 89]
assert heap_replace([25, 44, 68, 21, 39, 23, 89],500)==[23, 25, 68, 44, 39, 500, 89]
[BEGIN]

answer:  import heapq as hq

def heap_replace(heap, new_item):
    # Remove the smallest element from the heap
    hq.heappop(heap)
    # Insert the new item into the heap
    hq.heappush(heap, new_item)
    return heap

# Test cases
assert heap_replace([25, 44, 68, 21, 39, 23, 89], 21) == [21, 25, 23, 44, 39, 68, 89]
assert heap_replace([25, 44, 68, 21, 39, 23, 89], 110) == [23, 25, 68, 44, 39, 110, 89]
assert heap_replace([25, 44, 68, 21, 39, 23, 89], 500) == []  # This should result in an empty list


