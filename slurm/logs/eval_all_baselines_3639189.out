You are an expert Python programmer, and here is your task: Write a function to check whether the given month number contains 31 days or not. Your code should pass these tests:

assert check_monthnumb_number(5)==True
assert check_monthnumb_number(2)==False
assert check_monthnumb_number(6)==False
[BEGIN]

answer:  def check_monthnumb_number(month):
    if month == 1:
        return False
    elif month == 2:
        return False
    elif month == 3:
        return False
    elif month == 4:
        return False
    elif month == 5:
        return True
    elif month == 6:
        return False
    elif month == 7:
        return False
    elif month == 8:
        return False
    elif month == 9:
        return False
    elif month == 10:
        return True
    elif month == 11:
        return True
    elif month == 12:
        return True
    else:
        return False

