You are an expert Python programmer, and here is your task: Write a function to find the kth element in the given array. Your code should pass these tests:

assert kth_element([12,3,5,7,19], 5, 2) == 3
assert kth_element([17,24,8,23], 4, 3) == 8
assert kth_element([16,21,25,36,4], 5, 4) == 36
[BEGIN]

answer:  def kth_element(arr, n, k):
    if k < 1 or k > n:
        raise ValueError("k must be between 1 and n")
    return arr[k-1]

# Test cases
assert kth_element([12, 3, 5, 7, 19], 5, 2) == 3
assert kth_element([17, 24, 8, 23], 4, 3) == 8
assert kth_element([16, 21, 25, 36, 4], 5, 4) == 36

# Additional test cases
assert kth_element([1, 2, 3, 4, 5], 5, 1) == 1
assert kth_element([1, 2, 3, 4, 5], 5, 5) == 5
assert kth_element([1, 2, 3, 4, 5], 5, 3) == 3

# Run the tests
print("All tests passed!")

