You are an expert Python programmer, and here is your task: Write a function to remove characters from the first string which are present in the second string. Your code should pass these tests:

assert remove_dirty_chars("probasscurve", "pros") == 'bacuve'
assert remove_dirty_chars("digitalindia", "talent") == 'digiidi'
assert remove_dirty_chars("exoticmiles", "toxic") == 'emles' 
[BEGIN]

answer:  def remove_dirty_chars(str1, str2):
    # Create a set of characters from the second string
    char_set = set(str2)
    
    # Create a list of characters from the first string
    char_list = list(str1)
    
    # Filter out characters from the first string that are in the second string
    filtered_chars = [char for char in char_list if char not in char_set]
    
    # Join the filtered characters back into a string
    result = ''.join(filtered_chars)
    
    return result

# Test cases
assert remove_dirty_chars("probasscurve", "pros") == 'bacuve'
assert remove_dirty_chars("digitalindia", "talent") == 'digiidi'
assert remove_dirty_chars("exoticmiles", "toxic") == 'emles'

print("All tests passed!")


