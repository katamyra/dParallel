assert all_Bits_Set_In_The_Given_Range(17,2,4) == True
assert all_Bits_Set_In_The_Given_Range(39,4,6) == False
[BEGIN]

answer:  def all_Bits_Set_In_The_Given_Range(n, start, end):
    result = True
    for i in range(start, end + 1):
        if (n >> i) & 1 == 0:
            result = False
            break
    return result

