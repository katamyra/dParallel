You are an expert Python programmer, and here is your task: Write a function to find the number of possible sequences of length n such that each of the next element is greater than or equal to twice of the previous element but less than or equal to m. Your code should pass these tests:

assert get_total_number_of_sequences(10, 4) == 4
assert get_total_number_of_sequences(5, 2) == 6
assert get_total_number_of_sequences(16, 3) == 84
[BEGIN]

answer:  def get_total_number_of_sequences(n, m):
    # Initialize a list to store the number of valid sequences of each length
    dp = [0] * (n + 1)
    
    # Base case: a sequence of length 0 is always valid
    dp[0] = 1
    
    # Iterate over each possible length of the sequence
    for i in range(1, n + 1):
        # Iterate over each possible value for the last element of the sequence
        for j in range(1, m + 1):
            # Iterate over each possible value for the second-to-last element of the sequence
            for k in range(1, m + 1):
                # Iterate over each possible value for the third-to-last element of the sequence
                for l in range(1, m + 1):
                    # Calculate the number of valid sequences of length i
                    dp[i] += dp[i - 1] * dp[i - 2] * dp[i - 3] * dp[i - 4]
    
    # Return the number of valid sequences of length n
    return dp[n]

