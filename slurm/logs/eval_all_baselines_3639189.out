You are an expert Python programmer, and here is your task: Write a function to find the top k integers that occur most frequently from given lists of sorted and distinct integers using heap queue algorithm. Your code should pass these tests:

assert func([[1, 2, 6], [1, 3, 4, 5, 7, 8], [1, 3, 5, 6, 8, 9], [2, 5, 7, 11], [1, 4, 7, 8, 12]],3)==[5, 7, 1]
assert func([[1, 2, 6], [1, 3, 4, 5, 7, 8], [1, 3, 5, 6, 8, 9], [2, 5, 7, 11], [1, 4, 7, 8, 12]],1)==[1]
assert func([[1, 2, 6], [1, 3, 4, 5, 7, 8], [1, 3, 5, 6, 8, 9], [2, 5, 7, 11], [1, 4, 7, 8, 12]],5)==[6, 5, 7, 8, 1]
[BEGIN]

answer:  import heapq as hq
from collections import Counter

def func(lists, k):
    # Flatten the list of lists
    flat_list = [item for sublist in lists for item in sublist]
    
    # Count the frequency of each item
    frequency = Counter(flat_list)
    
    # Use heap queue to find the top k elements
    top_k = hq.nlargest(k, frequency.keys())
    
    # Convert the top k elements to integers
    return [int(item) for item in top_k]

# Test cases
assert func([[1, 2, 6], [1, 3, 4, 5, 7, 8], [1, 3, 5, 6, 8, 9], [2, 5, 7, 11], [1, 4, 7, 8, 12]], 3) == [5, 7, 1]
assert func(lists, 1) == [1]
assert func(lists, 5) == [6, 5, 7, 8, 1]
