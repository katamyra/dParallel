assert find_ways(4) == 2
assert find_ways(6) == 5
assert find_ways(8) == 14
[BEGIN]

answer:  def find_ways(n):
    count = 0
    for i in range(1, n + 1):
        for j in range(1, n + 1):
            if i + j == n:
                count += 1
    return count

