You are an expert Python programmer, and here is your task: Write a function to find the maximum value in a given heterogeneous list. Your code should pass these tests:

assert max_val(['Python', 3, 2, 4, 5, 'version'])==5
assert max_val(['Python', 15, 20, 25])==25
assert max_val(['Python', 30, 20, 40, 50, 'version'])==50
[BEGIN]

answer:  def max_val(heterogeneous_list):
    if not heterogeneous_list:
        raise ValueError("The list is empty")
    
    # Convert the list to a set to remove duplicates
    unique_elements = set(heterogeneous_list)
    
    # Convert the set back to a list and find the maximum value
    max_value = max(list(unique_elements))
    
    return max_value

# Tests
assert max_val(['Python', 3, 2, 4, 5, 'version']) == 5
assert max_val(['Python', 15, 20, 25]) == 25
assert max_val(['Python', 30, 20, 40, 50, 'version']) == 50

print("All tests passed!")


