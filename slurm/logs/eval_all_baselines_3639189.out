You are an expert Python programmer, and here is your task: Write a function to find the surface area of a cone. Your code should pass these tests:

assert surfacearea_cone(5,12)==282.7433388230814
assert surfacearea_cone(10,15)==880.5179353159282
assert surfacearea_cone(19,17)==2655.923961165254
[BEGIN]

answer:  import math

def surfacearea_cone(r, l):
    # Calculate the lateral surface area
    lateral_area = 2 * math.pi * r * l
    
    # Calculate the area of the base
    base_area = math.pi * r ** 2
    
    # Calculate the total surface area
    total_surface_area = lateral_area + base_area
    
    return total_surface_area

# Test cases
assert surfacearea_cone(5, 12) == 282.7433388230814
assert surfacearea_cone(10, 15) == 880.5179353159282
assert surfacearea_cone(19, 17) == 2655.923961165254

print("All tests passed!")


