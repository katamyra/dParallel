\[6x - 1 = 0 \Rightarrow x = \frac{1}{6},\]
\[4x - 1 = 0 \Rightarrow x = \frac{1}{4},\]
\[3x - 1 = 0 \Rightarrow x = \frac{1}{3},\]
\[x - 5 = 0 \Rightarrow x = 5.\]

